# Variables du CLIENT UTCP qui consomme ce manuel (fichier .env lu par load_variables_from).
# Namespacées par le nom du manuel : "atlassian" -> préfixe "atlassian_"
# (règle python-utcp : `_` doublés, `-` remplacés par `_`, puis `_` + variable).
# Jeton : https://id.atlassian.com/manage-profile/security/api-tokens
atlassian_ATLASSIAN_USERNAME=prenom.nom@monentreprise.example
atlassian_ATLASSIAN_API_TOKEN=remplacer-par-le-jeton-d-api-atlassian
