# Variables du SERVICE (à exporter avant `python -m serveur_utcp_atlassian`).
# Aucun secret ici : les identifiants Atlassian appartiennent au client UTCP.
ATLASSIAN_SITE=https://monsite.atlassian.net
# Seulement si le manuel cite ${BASE_URL} (URL publique de ce service) :
# ATLASSIAN_URL_PUBLIQUE=https://utcp.monentreprise.example
ATLASSIAN_ECOUTE_HOTE=127.0.0.1
ATLASSIAN_ECOUTE_PORT=8081
ATLASSIAN_JOURNAL=INFO
ATLASSIAN_JOURNAL_FORMAT=texte
